/* pages/documents/documents.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 32rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.title-block .t-title { font-size: 17px; font-weight: 600; color: #1f2430; }
.title-block .t-sub { font-size: 12px; color: #9aa0ab; margin-top: 4rpx; }

.upload-btn {
  background: #3b4f87 !important;
  color: #fff !important;
  border-radius: 14rpx !important;
  padding: 0 28rpx !important;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 13px;
  font-weight: 500;
}
.upload-btn::after { border: none; }

.doc-list { display: flex; flex-direction: column; gap: 20rpx; }
.doc-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.05);
  border: 1rpx solid #eef0f4;
}
.doc-main { display: flex; align-items: center; gap: 20rpx; }
.doc-icon {
  width: 64rpx; height: 64rpx;
  border-radius: 14rpx;
  background: #eef1fb;
  color: #3b4f87;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.doc-info { flex: 1; min-width: 0; }
.doc-title {
  font-size: 14px;
  font-weight: 500;
  color: #1f2430;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.doc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 11px;
  color: #9aa0ab;
  flex-wrap: wrap;
}
.doc-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eef0f4;
}
.act-btn {
  font-size: 12px;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  background: #eef1fb;
  color: #3b4f87;
}
.act-btn.danger { background: #fdeaea; color: #c33d3d; }

/* —— 上传遮罩 —— */
.upload-mask {
  position: fixed; inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 100;
  display: flex; align-items: center; justify-content: center;
}
.upload-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 56rpx;
  width: 76%;
  text-align: center;
}
.upload-title {
  font-size: 14px;
  color: #1f2430;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.upload-progress {
  font-size: 32px;
  font-weight: 700;
  color: #3b4f87;
  margin-bottom: 16rpx;
}
.upload-hint {
  font-size: 12px;
  color: #9aa0ab;
  line-height: 1.5;
}
