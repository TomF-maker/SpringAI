/* pages/dashboard/dashboard.wxss - 卡片 + 条形对比，不引 ECharts */

.page { min-height: 100vh; padding: 24rpx 28rpx 48rpx; box-sizing: border-box; }

.section { margin-bottom: 36rpx; }
.section-title {
  font-size: 13px;
  font-weight: 600;
  color: #1f2430;
  margin: 0 0 16rpx 12rpx;
}
.section-title-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.range-switch {
  display: flex;
  background: #eef0f4;
  border-radius: 12rpx;
  padding: 4rpx;
}
.range {
  padding: 8rpx 20rpx;
  font-size: 12px;
  color: #6b7280;
  border-radius: 8rpx;
}
.range.active { background: #3b4f87; color: #fff; }

/* —— 统计卡片 —— */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 1rpx solid #eef0f4;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 48, 0.04);
  position: relative;
  overflow: hidden;
}
.stat-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #3b4f87, #e8a13a);
  opacity: 0;
  transition: opacity 0.18s ease;
}
.stat-card:active::after { opacity: 1; }
.stat-icon { font-size: 22px; margin-bottom: 8rpx; }
.stat-num {
  font-size: 22px;
  font-weight: 700;
  color: #2b3a67;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.stat-label { font-size: 11px; color: #6b7280; margin-top: 4rpx; }

/* —— 提问数据卡片 —— */
.qa-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.05);
  border: 1rpx solid #eef0f4;
}
.qa-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx 12rpx;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #eef0f4;
}
.qa-item { text-align: center; }
.qa-num {
  font-size: 22px;
  font-weight: 700;
  color: #2b3a67;
  font-variant-numeric: tabular-nums;
}
.qa-label { font-size: 11px; color: #9aa0ab; margin-top: 4rpx; }

/* —— 条形对比 —— */
.bar-section { margin-bottom: 24rpx; }
.bar-title {
  font-size: 12px;
  color: #6b7280;
  margin-bottom: 16rpx;
}
.bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  font-size: 12px;
}
.bar-label {
  width: 180rpx;
  color: #6b7280;
  font-size: 12px;
  flex-shrink: 0;
}
.bar-track {
  flex: 1;
  height: 16rpx;
  background: #f1f3f5;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #3b4f87;
  border-radius: 8rpx;
  transition: width 0.3s ease;
  min-width: 2rpx;
}
.bar-fill.fill-doc { background: #3b4f87; }
.bar-fill.fill-local { background: #7c5cae; }
.bar-fill.fill-tool { background: #e8a13a; }
.bar-fill.fill-gap { background: #c33d3d; }
.bar-fill.fill-error { background: #94a3b8; }
.bar-num {
  min-width: 56rpx;
  text-align: right;
  color: #1f2430;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.qa-footer {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #6b7280;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eef0f4;
}
.qa-footer .hl {
  color: #3b4f87;
  font-weight: 600;
  margin-left: 6rpx;
}

.warn-box {
  background: #fdf3e0;
  border: 1rpx solid #f4dca8;
  color: #b8791a;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 12px;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
.error-box {
  background: #fdeaea;
  border: 1rpx solid #f5c2c7;
  color: #c33d3d;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 13px;
  margin-bottom: 24rpx;
}
