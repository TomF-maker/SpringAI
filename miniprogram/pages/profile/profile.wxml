<!-- pages/profile/profile.wxml - 个人中心 -->
<view class="page">
  <view class="profile-head">
    <view class="avatar">{{avatarText}}</view>
    <view class="head-info">
      <view class="name">{{user.realName || user.username || '用户'}}</view>
      <view class="sub">{{user.username || ''}}</view>
    </view>
  </view>

  <view wx:if="{{membership.active}}" class="member-card">
    <view class="member-badge">{{membership.planName}}</view>
    <view class="member-info">
      <view class="member-title">{{membership.permanent ? '永久会员' : '有效会员'}}</view>
      <view class="member-expire" wx:if="{{!membership.permanent}}">到期：{{membership.expireText}}</view>
      <view class="member-expire" wx:else>不限提问次数</view>
    </view>
    <view class="member-points">{{points}} 积分</view>
  </view>
  <view wx:elif="{{!loading}}" class="member-card member-card-guest">
    <view class="member-badge member-badge-guest">普通用户</view>
    <view class="member-info">
      <view class="member-title">每日免费 {{freeLimit}} 次</view>
      <view class="member-expire">今日剩余 {{freeRemaining}} 次</view>
    </view>
    <view class="member-points">{{points}} 积分</view>
  </view>

  <view class="section-title">账号信息</view>
  <view class="info-card">
    <view class="info-row">
      <text class="info-label">用户名</text>
      <text class="info-value">{{user.username || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">真实姓名</text>
      <text class="info-value">{{user.realName || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">邮箱</text>
      <text class="info-value">{{user.email || '未绑定'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">手机号</text>
      <text class="info-value">{{user.phone || '未绑定'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">部门</text>
      <text class="info-value">{{user.departmentName || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">公司</text>
      <text class="info-value">{{user.companyName || '-'}}</text>
    </view>
    <view class="info-row" wx:if="{{user.lastLoginTime}}">
      <text class="info-label">上次登录</text>
      <text class="info-value">{{lastLoginText}}</text>
    </view>
  </view>

  <view class="section-title">操作</view>
  <view class="action-card">
    <view class="action-row" bindtap="goDocuments" wx:if="{{isAdmin}}">
      <text>文档管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="action-row" bindtap="goDashboard" wx:if="{{isAdmin}}">
      <text>数据看板</text>
      <text class="arrow">›</text>
    </view>
    <view class="action-row" bindtap="callAdmin">
      <text>联系管理员</text>
      <text class="arrow">›</text>
    </view>
    <view class="action-row danger" bindtap="doLogout">
      <text>退出登录</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{!loading && !user.username}}" class="pa-empty" style="margin-top: 80rpx;">
    登录后查看个人信息
    <view style="margin-top: 16rpx;">
      <button class="pa-btn" style="display:inline-block; padding: 16rpx 60rpx;" bindtap="goLogin">去登录</button>
    </view>
  </view>
</view>
