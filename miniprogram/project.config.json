{
  "miniprogramRoot": "./",
  "projectname": "知行信咨询助手",
  "description": "知行信咨询助手小程序端 - 企业级 RAG 知识库问答",
  "appid": "touristappid",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "newFeature": true,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "scopeDataCheck": false,
    "uglifyFileName": true,
    "checkInvalidKey": true,
    "disableUseStrict": false,
    "useCompilerModule": true,
    "userConfirmedUseCompilerModuleSwitch": false,
    "ignoreUploadUnusedFiles": true
  },
  "compileType": "miniprogram",
  "libVersion": "2.32.0",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" }
    ],
    "include": []
  },
  "debugOptions": { "hidedInDevtools": [] }
}
